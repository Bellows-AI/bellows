{
    "name": "@bellows-ai/bellows-cli",
    "version": "0.0.0",
    "description": "Command-line client for the Bellows Factory board",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Bellows-AI/bellows.git",
        "directory": "cli"
    },
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "bin": {
        "bellows": "dist/index.js"
    },
    "files": [
        "dist/**/*.js"
    ],
    "scripts": {
        "build": "tsc -b",
        "dev": "tsx --env-file-if-exists=../.env src/index.ts"
    },
    "devDependencies": {
        "tsx": "^4.19.0"
    }
}
