# The secret store's configuration (docs/secrets.md). REQUIRED on every dashboard boot: a missing or
# malformed value refuses to boot and names the variable. `npm run secrets:init` writes a secrets.env
# (gitignored) with fresh keys if none exists, and adds SECRETS_BACKEND to one written by an older release;
# this file shows the format for doing it by hand.
#
# Deliberately NOT in .env: the driver and the CLIs load .env, and these keys decrypt every stored
# credential. Only the dashboard's launchers (`npm run dev`, `npm start`, `npm run secrets:rotate`)
# and the compose dashboard service read secrets.env.

# Where secret payloads live: `database` (AES-256-GCM envelopes in PostgreSQL, under the data keys below) or
# `aws` (the plaintext in AWS Secrets Manager) or `vault` (the plaintext in a HashiCorp Vault KV v2 mount);
# with either, PostgreSQL keeps a reference and a MAC. One backend per deployment; switching with secrets already
# stored is not supported.
SECRETS_BACKEND=database

# database only. Comma-separated <keyId>:<base64 of exactly 32 bytes>; a key id is [a-z0-9-], up to 32 characters.
# Generate one with: echo "k1:$(openssl rand -base64 32)"
SECRETS_DATA_KEYS=
# database only. The key id new versions are encrypted under; it must be in SECRETS_DATA_KEYS.
SECRETS_ACTIVE_KEY_ID=
# Every backend. Base64, 32 bytes each (openssl rand -base64 32); distinct from each other and from every data key.
# They cannot be rotated: changing either invalidates outstanding operation ids.
SECRETS_OPERATION_KEY=
SECRETS_FINGERPRINT_KEY=

# aws only (leave unset with any other backend; a set value is refused). Production authenticates with
# workload identity (an IRSA role or EKS Pod Identity), so no key is set here.
# SECRETS_AWS_REGION=eu-west-1
# The deployment's namespace in Secrets Manager, slash-separated, no leading or trailing slash.
# SECRETS_AWS_PREFIX=factory/dev
# Development against an emulator only (docker compose --profile secrets-aws up -d moto): its URL, and a static
# key pair, both or neither.
# SECRETS_AWS_ENDPOINT=http://moto:5000
# SECRETS_AWS_ACCESS_KEY_ID=
# SECRETS_AWS_SECRET_ACCESS_KEY=

# vault only (leave unset with any other backend; a set value is refused). The Vault origin, no path.
# SECRETS_VAULT_ADDR=https://vault.example.com:8200
# The KV v2 mount, and the deployment's namespace in it (slash-separated, no leading or trailing slash).
# SECRETS_VAULT_MOUNT=secret
# SECRETS_VAULT_PREFIX=factory/dev
# `kubernetes` (production): log in with the pod's projected service-account token. Needs the role and the file.
# `token` (development and tests only): a fixed client token. Needs the token alone.
# SECRETS_VAULT_AUTH=token
# SECRETS_VAULT_ROLE=factory
# SECRETS_VAULT_TOKEN_FILE=/var/run/secrets/vault/token
# Development against docker compose --profile secrets-vault up -d vault: the dev server's root token.
# SECRETS_VAULT_TOKEN=factory-dev-root
