# The secret store's keys (docs/secrets.md). REQUIRED on every dashboard boot: a missing or malformed
# value refuses to boot and names the variable. `npm run secrets:init` writes a secrets.env (gitignored)
# with fresh keys if none exists; this file shows the format for doing it by hand.
#
# Deliberately NOT in .env: the driver and the CLIs load .env, and these keys decrypt every stored
# credential. Only the dashboard's launchers (`npm run dev`, `npm start`, `npm run secrets:rotate`)
# and the compose dashboard service read secrets.env.

# Comma-separated <keyId>:<base64 of exactly 32 bytes>; a key id is [a-z0-9-], up to 32 characters.
# Generate one with: echo "k1:$(openssl rand -base64 32)"
SECRETS_DATA_KEYS=
# The key id new versions are encrypted under; it must be in SECRETS_DATA_KEYS.
SECRETS_ACTIVE_KEY_ID=
# Base64, 32 bytes each (openssl rand -base64 32); distinct from each other and from every data key.
# They cannot be rotated: changing either invalidates outstanding operation ids.
SECRETS_OPERATION_KEY=
SECRETS_FINGERPRINT_KEY=
