{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "composite": false,
        "noEmit": true,
        "declaration": false,
        "declarationMap": false,
        "sourceMap": false,
        "allowJs": true,
        "checkJs": false,
        "verbatimModuleSyntax": false,
        "exactOptionalPropertyTypes": false,
        "noUncheckedIndexedAccess": false,
        "types": ["node"]
    },
    "include": ["src/scripts/*.cjs"]
}
